# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database: SQLite by default. For Postgres:
# DATABASE_URL=postgres://user:pass@host:5432/bookleaf

# --- AI (server-side only; never exposed to the browser) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_ASYNC_CLASSIFICATION=true
# Indicative pricing (USD per million tokens) for the cost panel
AI_PRICE_INPUT_PER_MTOK=1.0
AI_PRICE_OUTPUT_PER_MTOK=5.0

# Optional: pin "today" for royalty-cycle maths so demo answers line up with the sample data
# BOOKLEAF_REFERENCE_DATE=2026-01-10

# Seed passwords (python manage.py seed_demo)
SEED_AUTHOR_PASSWORD=author123
SEED_ADMIN_PASSWORD=admin123
